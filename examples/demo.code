par([
    s(["sn", "sn", "bd"].cat.fast(1.5))
    .struct([[1, 1, ~].cat, ~, 1].fc)
    .fast(2),
    n(
        [1, 2, 3, 4, 5, 6, 7, 8].fc
        .struct([1].cat.fast(3))
        .add([0, 2].cat.slow(2))
        .scale(["major5", "minor5"].cat)
    )
    @s("superpiano")
    @velocity([0.7, 1.1].cat.slow(2))
    @room(0.2)
])